# SPDX-License-Identifier: MIT
# agecidi.config: allnoconfig üzerine uygulanan Kconfig parçası (Linux 6.18, ARCH=arm64).
# QEMU "virt" makinesinde açılabilen, kitabın tüm uygulamalarını destekleyen en küçük çekirdek.
# Kullanım: bkz. derle.sh

# --- Temel ---
CONFIG_LOCALVERSION="-agecidi"
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_POSIX_TIMERS=y
CONFIG_KALLSYMS=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# --- Açılış: initramfs, devtmpfs, sanal dosya sistemleri ---
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_UEVENT_HELPER=y
CONFIG_FW_LOADER=y

# --- Modüller ---
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# --- Seri konsol (QEMU virt: PL011 UART) ve RTC (PL031) ---
CONFIG_TTY=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_RTC_CLASS=y
# allnoconfig tabanında varsayılanı y olan seçenekler de kapanır; açıkça yazılmalıdır
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_INTF_SYSFS=y
CONFIG_RTC_INTF_DEV=y
CONFIG_RTC_DRV_PL031=y

# --- Blok aygıtı ve ağ (virtio-mmio) ---
CONFIG_BLOCK=y
# VIRTIO_BLK, BLK_DEV menüsüne bağlıdır (depends on); menü açılmazsa seçenek sessizce düşer
CONFIG_BLK_DEV=y
CONFIG_EXT4_FS=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_NET=y
CONFIG_INET=y
CONFIG_UNIX=y
CONFIG_PACKET=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_VIRTIO_NET=y
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y
# IPv6 bu üründe kullanılmaz (INET ile varsayılan olarak açılır)
# CONFIG_IPV6 is not set

# --- Modül olarak derlenen sürücü (Bölüm 5: uevent -> modprobe) ---
CONFIG_HW_RANDOM=m
CONFIG_HW_RANDOM_VIRTIO=m

# --- Hata ayıklama (Bölüm 8) ---
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_FS=y
CONFIG_DYNAMIC_DEBUG=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_FUNCTION_GRAPH_TRACER=y
CONFIG_DEBUG_INFO_DWARF5=y
CONFIG_GDB_SCRIPTS=y
CONFIG_KGDB=y
CONFIG_KGDB_SERIAL_CONSOLE=y
