# SPDX-License-Identifier: MIT
# /etc/systemd/network/10-eth0.network: systemd-networkd ile eth0 yapılandırması. Bölüm 7.
[Match]
Name=eth0

[Network]
# Fabrikada DHCP; sahada sabit adres gerekiyorsa aşağıdaki satırlar açılır
DHCP=ipv4
#Address=192.168.10.20/24
#Gateway=192.168.10.1
#DNS=192.168.10.1
NTP=pool.ntp.org

[DHCPv4]
UseHostname=no
